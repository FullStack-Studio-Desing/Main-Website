# Mercado Pago Checkout API — test credentials from Your integrations.
# Create the application yourself (Checkout API). Access Token stays on the server.
# Public Key is for a future card form. No payment form is mounted yet.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Webhooks → Configure notifications → signature secret.
MP_WEBHOOK_SECRET=

# Orders API requires a payer, and a Mexico seller usually also needs RFC or CURP.
# The future card form collects only card number, expiration, and security code.
# These stay on the server until a trusted customer record exists. Do not send them from the browser.
MP_PAYER_EMAIL=
MP_PAYER_ID_TYPE=
MP_PAYER_ID_NUMBER=

# Contact form via Resend (no Gmail SMTP).
# Sandbox: from onboarding@resend.dev; to must be the Resend account email until a domain is verified.
RESEND_API_KEY=
RESEND_FROM="FullStack Studio Design <onboarding@resend.dev>"
RESEND_TO=
