# Mercado Pago Checkout API — credentials from Your integrations.
# Access Token stays on the server. Public Key powers the portal card-on-file form.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Webhooks → Configure notifications → signature secret.
MP_WEBHOOK_SECRET=

# Used by the public marketing checkout (/api/process-payment).
# Email is required. RFC/CURP are optional (omit for US clients).
MP_PAYER_EMAIL=
# MP_PAYER_ID_TYPE=
# MP_PAYER_ID_NUMBER=

# Optional absolute site URL for invoice emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form via Resend (no Gmail SMTP).
# Sandbox: from onboarding@resend.dev; to must be the Resend account email until a domain is verified.
RESEND_API_KEY=
RESEND_FROM="FullStack Studio Design <onboarding@resend.dev>"
RESEND_TO=

# Supabase → Project Settings → API.
# Copy the values into .env.local. Do not commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only. Used to create client logins and promote the admin email.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated. These emails become studio admins the next time they sign in.
PORTAL_ADMIN_EMAILS=you@yourstudio.com

# Cloudflare R2 public media base (no trailing slash).
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-95a4793aaea94b2b99d642e24003ffe5.r2.dev
